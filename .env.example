# ------------------------------------------------------------------------------
# Growth OS — environment configuration
#
# Copy this file to `.env` and fill in the values for the integrations you use.
# Every key is your own; Growth OS reads them locally and never transmits them.
# Each block links to the setup guide with click-by-click instructions.
#
# Tiers:  🟢 zero-approval (connect in minutes)   🔴 approval + lead time (start early)
# ------------------------------------------------------------------------------


# ── 🟢 Google Analytics 4 ─────────────────────────────────────────────────────
# Guide: docs/integrations/ga4.md
# Create a service account, grant it Viewer on the GA4 property, download the JSON.
# GA4_PROPERTY_ID is the numeric property id (Admin → Property Settings), NOT "G-XXXX".
# GOOGLE_APPLICATION_CREDENTIALS is an absolute path to the downloaded key file.
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/ga4-service-account.json


# ── 🟢 Google Search Console ──────────────────────────────────────────────────
# Guide: docs/integrations/google-search-console.md
# Reuses the SAME service account as GA4 — just add it as a user in Search Console
# and grant the webmasters.readonly scope. Set the exact verified property URL,
# e.g. https://example.com/  or  sc-domain:example.com
GSC_SITE_URL=


# ── 🔴 Google Ads ─────────────────────────────────────────────────────────────
# Guide: docs/integrations/google-ads.md
# Needs a developer token from an approved Manager (MCC) account. Test/Explorer
# access works to start. Create an OAuth client for the refresh token flow.
# LOGIN_CUSTOMER_ID is the MCC id with dashes removed (e.g. 1234567890).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=


# ── 🔴 Meta Marketing + Instagram ─────────────────────────────────────────────
# Guide: docs/integrations/meta-instagram.md
# Requires Business Verification FIRST (~14+ days), then App Review for the
# ads_read / instagram_* permissions. META_ACCESS_TOKEN is a long-lived token.
# META_AD_ACCOUNT_ID includes the "act_" prefix (e.g. act_1234567890).
# META_IG_USER_ID is the Instagram Business account id linked to the Page.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_IG_USER_ID=


# ── 🟢 MailerLite ─────────────────────────────────────────────────────────────
# Guide: docs/integrations/mailerlite.md
# Generate a Bearer API key in the MailerLite dashboard (Integrations → API).
MAILERLITE_API_KEY=


# ── 🟢 PageSpeed Insights ─────────────────────────────────────────────────────
# Guide: docs/integrations/ga4.md  (PageSpeed section)
# Create an API key in Google Cloud and enable the PageSpeed Insights API.
PAGESPEED_API_KEY=


# ── Agent model ───────────────────────────────────────────────────────────────
# Your own Anthropic key for the reasoning steps (positioning, audit synthesis,
# GEO analysis). Bring your own — Growth OS never proxies model calls.
ANTHROPIC_API_KEY=
